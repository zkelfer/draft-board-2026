{
  "manifest_version": 3,
  "name": "Draft Board Sync",
  "version": "0.4.1",
  "description": "Mirrors your Yahoo draft room picks onto the Draft Board 2026 page. Personal use.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://football.fantasysports.yahoo.com/*"
      ],
      "js": [
        "yahoo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://zkelfer.github.io/draft-board-2026/*",
        "http://127.0.0.1:8737/*",
        "http://localhost:8737/*",
        "file:///*"
      ],
      "js": [
        "board.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Draft Board Sync \u2014 reads the Yahoo draft room tab, feeds the board tab"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}